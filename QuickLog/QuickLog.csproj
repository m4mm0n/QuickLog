<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>ZLS.QuickLog</PackageId>
    <Version>2.4.0</Version>
    <AssemblyVersion>2.4.0.0</AssemblyVersion>
    <FileVersion>2.4.0.0</FileVersion>
    <PackageVersion>2.4.0</PackageVersion>

    <Product>QuickLog</Product>
    <Company>ZeroLinez Softworx</Company>
    <Authors>Geir Gustavsen</Authors>
    <Copyright>Copyright © ZeroLinez Softworx 2024–2026</Copyright>
    <Description>High-performance, engine-grade logging with exception ownership, crash dumps, auto-restart, and Godot integration. Zero external dependencies.</Description>
    <PackageTags>logging;gamedev;godot;linux;exceptions;crash-dump;async</PackageTags>
    <RepositoryUrl>https://github.com/m4mm0n/QuickLog</RepositoryUrl>
    <PackageProjectUrl>https://github.com/m4mm0n/QuickLog</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>QuickLog v2.4.0 adds verified Linux support with XDG-aware log profiles, Ubuntu CI and smoke coverage, active-log reader hardening, strict CLI option validation, and clean sample reruns. Zero runtime dependencies.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\CHANGELOG.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>QuickLog.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
