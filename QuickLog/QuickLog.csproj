<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>ZLS.QuickLog</PackageId>
    <Version>2.1.0</Version>
    <AssemblyVersion>2.1.0.0</AssemblyVersion>
    <FileVersion>2.1.0.0</FileVersion>
    <PackageVersion>2.1.0</PackageVersion>

    <Product>QuickLog</Product>
    <Company>ZeroLinez Softworx</Company>
    <Authors>Geir Gustavsen</Authors>
    <Copyright>Copyright © ZeroLinez Softworx 2024–2026</Copyright>
    <Description>High-performance, engine-grade logging with exception ownership, crash dumps, auto-restart, and Godot integration. Zero external dependencies.</Description>
    <PackageTags>logging;gamedev;godot;exceptions;crash-dump;async</PackageTags>
    <RepositoryUrl>https://github.com/m4mm0n/QuickLog</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>QuickLog.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
