<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>

    <PackageId>ZLS.QuickLog</PackageId>
    <Version>3.0.0</Version>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <FileVersion>3.0.0.0</FileVersion>
    <PackageVersion>3.0.0</PackageVersion>

    <Product>QuickLog</Product>
    <Company>ZeroLinez Softworx</Company>
    <Authors>Geir Gustavsen</Authors>
    <Copyright>Copyright © ZeroLinez Softworx 2024–2026</Copyright>
    <Description>High-performance, engine-grade logging with exception ownership, crash dumps, auto-restart, and Godot integration. Zero external dependencies.</Description>
    <PackageTags>logging;gamedev;godot;windows;linux;macos;android;ios;exceptions;crash-dump;async</PackageTags>
    <RepositoryUrl>https://github.com/m4mm0n/QuickLog</RepositoryUrl>
    <PackageProjectUrl>https://github.com/m4mm0n/QuickLog</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>QuickLog v3.0.0 adds typed structured events, QLOG v3 with legacy reads, allocation-aware logging, async lifecycle APIs, compressed retention, richer diagnostics tools, portable profiles, and release-grade AOT and package verification. The core remains dependency-free.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\CHANGELOG.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>QuickLog.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
